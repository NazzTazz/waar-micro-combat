{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waar-cohort-ruleset/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelVersion", "version", "units", "targetingMode", "targeting", "engagements", "maxRounds", "surrender", "tieBreak"],
  "properties": {
    "schemaVersion": { "const": "waar-cohort-ruleset/2" },
    "modelVersion": { "const": "waar-cohort-v2" },
    "version": { "type": "string", "minLength": 1 },
    "targetingMode": { "const": "proportional" },
    "maxRounds": { "type": "integer", "minimum": 1, "maximum": 100 },
    "units": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "attack", "structure", "cost", "baseAccuracy", "accuracySpread", "strikesPerAttack", "defendingEfficiency", "capturable"],
        "properties": {
          "type": { "enum": ["soldier", "spearman", "archer", "knight"] },
          "attack": { "$ref": "#/$defs/decimal" }, "structure": { "$ref": "#/$defs/decimal" },
          "cost": { "type": "integer", "minimum": 1, "maximum": 400400 },
          "baseAccuracy": { "$ref": "#/$defs/decimal" }, "accuracySpread": { "$ref": "#/$defs/decimal" },
          "strikesPerAttack": { "type": "integer", "minimum": 1, "maximum": 32 },
          "defendingEfficiency": { "$ref": "#/$defs/decimal" }, "capturable": { "type": "boolean" }
        }
      }
    },
    "targeting": { "$ref": "#/$defs/matrix" },
    "engagements": { "$ref": "#/$defs/matrix" },
    "surrender": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "deadRatio"],
      "properties": { "enabled": { "type": "boolean" }, "deadRatio": { "$ref": "#/$defs/decimal" } }
    },
    "tieBreak": {
      "type": "object", "additionalProperties": false, "required": ["criterion", "equality"],
      "properties": { "criterion": { "enum": ["economic", "structure"] }, "equality": { "enum": ["defender", "draw"] } }
    }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]{1,6})?$" },
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["soldier", "spearman", "archer", "knight"],
      "properties": { "soldier": { "type": "object" }, "spearman": { "type": "object" }, "archer": { "type": "object" }, "knight": { "type": "object" } }
    }
  }
}
