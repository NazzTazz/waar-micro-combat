        "B": {"mode": "explicit", "units": {"spearman": 5}}
      },
      "compositionVariants": [{"id": "reference", "operations": []}]
    },
    {
      "id": "d5-archer-spearman-large",
      "directions": "both",
      "weather": {"A": "neutral", "B": "neutral"},
      "modifiers": {"A": [], "B": []},
