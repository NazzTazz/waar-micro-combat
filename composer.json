{
    "name": "waar/micro-combat",
    "description": "Pure PHP 8.2 micro combat resolver for Waar",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Waar\\MicroCombat\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:js": [
            "node tests/acceptance-zones-model.test.js",
            "node tests/workshop-casualty-zones.test.js",
            "node tests/finalist-comparison-model.test.js",
            "node tests/finalist-stability-model.test.js",
            "node tests/mixed-composition-observation-model.test.js",
            "node tests/candidate-legacy-comparison.test.js",
            "node tests/workshop-model.test.js",
            "node tests/workshop-ui.test.js",
            "node tests/workshop-http.test.js",
            "node tests/workshop-runtime.test.js",
            "node tests/cohort-benchmark.test.js",
            "node tests/b1-benchmark.test.mjs"
        ],
        "test:all": ["@test", "@test:js"],
        "smoke": "php bin/run-wind-tunnel.php experiments/t24-astra-vector-corrections.json reports/smoke"
    }
}
